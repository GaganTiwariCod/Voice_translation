# Server Network Configuration
PORT=5000
HOST=0.0.0.0

# WebSocket Limits & Timeouts
WS_MAX_PAYLOAD_BYTES=1048576 # 1MB max payload per frame
SESSION_IDLE_TIMEOUT_MS=60000 # 60 seconds of silence/inactivity before cleanup
MAX_SESSIONS_PER_CLIENT=2
MAX_CONCURRENT_SESSIONS=20

# Audio Capture Specifications
EXPECTED_SAMPLE_RATE=16000
EXPECTED_CHANNELS=1
EXPECTED_ENCODING=pcm_s16le

# Queue Limits (Bounded Queues)
MAX_AUDIO_QUEUE_CHUNKS=100
MAX_TRANSLATION_QUEUE_ITEMS=50

# Speech Recognition Provider Configuration
# Supported: "vosk" (local streaming sidecar), "mock" (development testing)
STT_PROVIDER=vosk
VOSK_SIDECAR_PORT=2700
VOSK_MODEL_PATH_EN=./models/vosk-model-small-en-us-0.15
VOSK_MODEL_PATH_HI=./models/vosk-model-small-hi-0.22

# Translation Provider Configuration
# Supported: "indictrans2", "marian", "libretranslate", "mock"
TRANSLATION_PROVIDER=libretranslate
LIBRETRANSLATE_URL=https://translate.argosopentech.com
LIBRETRANSLATE_API_KEY=

# Logging Level: debug, info, warn, error
LOG_LEVEL=info
